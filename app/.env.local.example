# =============================================================================
# SportAI — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (get from https://app.supabase.com or your self-hosted instance)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Used for pgcrypto API key encryption — generate with: openssl rand -base64 32
SUPABASE_ENCRYPTION_KEY=your-32-char-encryption-key

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For Ngrok: set to your stable Ngrok domain, e.g. https://sportai.ngrok.io
# Update the Google OAuth redirect URI and the Strava callback domain to match

# -----------------------------------------------------------------------------
# AI Providers (system defaults — users can override with their own keys)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# MISTRAL_API_KEY=...

# -----------------------------------------------------------------------------
# Login (Google-only for now)
# Google OAuth is configured in the self-hosted Supabase (GoTrue) stack, not
# here — see docker/.env (GOOGLE_ENABLED / GOOGLE_CLIENT_ID / GOOGLE_SECRET)
# and the redirect URI in https://console.cloud.google.com/apis/credentials.
#
# ACCESS ALLOW-LIST (exact emails, comma/space separated). Only these accounts
# may sign in; everyone else is rejected at the OAuth callback. Matching is
# case-insensitive. LEAVE UNSET/EMPTY to disable the allow-list (allow anyone
# with a valid Google login) — handy for local dev.
#   ALLOWED_EMAILS="you@example.com, teammate@example.com"
# -----------------------------------------------------------------------------
ALLOWED_EMAILS=

# -----------------------------------------------------------------------------
# Strava DATA integration (import activities — NOT a login provider)
# Create an API application at https://www.strava.com/settings/api.
# "Authorization Callback Domain" must be the APP host (e.g. localhost, your
# app ngrok host, or the Cloud Run domain) WITHOUT scheme or path.
# Used server-side by the app to exchange the code and pull activities.
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
# USDA FoodData Central — free, get at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your-usda-api-key

# -----------------------------------------------------------------------------
# MCP Servers
# -----------------------------------------------------------------------------
# mem0 for long-term coaching memory — https://app.mem0.ai
MEM0_API_KEY=your-mem0-api-key

# -----------------------------------------------------------------------------
# Ngrok (for mobile testing)
# Get stable domain at https://dashboard.ngrok.com/domains
# -----------------------------------------------------------------------------
# NGROK_AUTHTOKEN=your-ngrok-authtoken
# NGROK_DOMAIN=sportai.ngrok.io

# -----------------------------------------------------------------------------
# Tunnel mode (dev only) — set to "ngrok" ONLY while testing via ngrok free tier.
# Makes client fetches send `ngrok-skip-browser-warning` to bypass the
# interstitial. Leave UNSET on localhost and in production.
# ngrok-sync.sh sets/clears this automatically.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_TUNNEL_MODE=
