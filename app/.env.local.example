# =============================================================================
# SportAI — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (get from https://app.supabase.com or your self-hosted instance)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Used for pgcrypto API key encryption — generate with: openssl rand -base64 32
SUPABASE_ENCRYPTION_KEY=your-32-char-encryption-key

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For Ngrok: set to your stable Ngrok domain, e.g. https://sportai.ngrok.io
# Update OAuth redirect URIs in Google/Apple/Facebook/Strava to match

# -----------------------------------------------------------------------------
# AI Providers (system defaults — users can override with their own keys)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# MISTRAL_API_KEY=...

# -----------------------------------------------------------------------------
# OAuth Providers (configure redirect URIs in each provider's dashboard)
# Google:   https://console.cloud.google.com/apis/credentials
# Apple:    https://developer.apple.com/account/resources/identifiers
# Facebook: https://developers.facebook.com/apps
# Strava:   https://www.strava.com/settings/api
# -----------------------------------------------------------------------------
# These are configured directly in Supabase Auth dashboard — not needed here
# unless you use a custom auth implementation

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
# USDA FoodData Central — free, get at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your-usda-api-key

# -----------------------------------------------------------------------------
# MCP Servers
# -----------------------------------------------------------------------------
# mem0 for long-term coaching memory — https://app.mem0.ai
MEM0_API_KEY=your-mem0-api-key

# -----------------------------------------------------------------------------
# Ngrok (for mobile testing)
# Get stable domain at https://dashboard.ngrok.com/domains
# -----------------------------------------------------------------------------
# NGROK_AUTHTOKEN=your-ngrok-authtoken
# NGROK_DOMAIN=sportai.ngrok.io

# -----------------------------------------------------------------------------
# Tunnel mode (dev only) — set to "ngrok" ONLY while testing via ngrok free tier.
# Makes client fetches send `ngrok-skip-browser-warning` to bypass the
# interstitial. Leave UNSET on localhost and in production.
# ngrok-sync.sh sets/clears this automatically.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_TUNNEL_MODE=
