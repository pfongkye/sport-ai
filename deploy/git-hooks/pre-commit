#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# SportAI pre-commit secret guard.
#
# Blocks a commit if it would introduce secret files or obvious secret content.
# This is a safety net on top of .gitignore — it catches cases where a file was
# force-added (git add -f) or the ignore rules were bypassed.
#
# Install with:  ./deploy/git-hooks/install.sh
# Bypass (discouraged, only if you are SURE):  git commit --no-verify
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

RED=$'\033[31m'; YEL=$'\033[33m'; NC=$'\033[0m'
blocked=0

# Files staged for this commit (added/copied/modified/renamed), NUL-safe.
staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')
[ -z "$staged" ] && exit 0

# 1) Block secret FILENAMES (real env files, keys, credential dumps).
#    Allow *.example templates through.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.example) continue ;;                       # templates are safe
  esac
  if printf '%s\n' "$f" | grep -qiE \
      '(^|/)\.env($|\.)|(^|/)secrets/|(^|/)\.ngrok\.rendered\.yml$|secret|credential|\.pem$|\.key$|\.p12$|\.keystore$|service-account.*\.json$|client_secret.*\.json$'; then
    echo "${RED}✗ blocked (secret-like filename):${NC} $f"
    blocked=1
  fi
done <<< "$staged"

# 2) Scan ADDED lines of staged text for high-signal secret patterns.
#    Kept deliberately narrow to avoid noise; env *values* are the main risk.
#    Exclude *.example templates — they intentionally contain CHANGE_ME placeholders
#    next to keys like POSTGRES_PASSWORD= and must not trip the value scan.
scan_files=()
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.example) continue ;;                       # templates: placeholders, not secrets
    deploy/git-hooks/*) continue ;;              # the guard itself contains detection
                                                 # patterns (POSTGRES_PASSWORD= etc.) —
                                                 # don't let it flag its own source.
  esac
  scan_files+=("$f")
done <<< "$staged"

added=""
if [ "${#scan_files[@]}" -gt 0 ]; then
  added=$(git diff --cached -U0 --diff-filter=ACMR -- "${scan_files[@]}" | grep -E '^\+' | grep -vE '^\+\+\+' || true)
fi
if [ -n "$added" ]; then
  # (a) Always-bad literals: private keys and provider key formats. These are real
  #     secrets no matter the context. (-e so a leading '-' isn't read as a flag.)
  if printf '%s\n' "$added" | grep -qiE -e \
      'BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY|sk-[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}'; then
    echo "${RED}✗ blocked (private key or API key literal in staged diff).${NC}"
    blocked=1
  fi

  # (b) Secret ENV ASSIGNMENTS (KEY=value). Flag only when the value looks like a
  #     real literal — NOT a variable ref ($FOO / ${FOO}), command substitution
  #     $(...), another KEY-name/:latest ref, or an empty/placeholder. This avoids
  #     flagging deploy scripts that merely READ secrets (e.g.
  #     `grep '^POSTGRES_PASSWORD=' .env` or `--set-secrets KEY=KEY:latest`).
  assigns=$(printf '%s\n' "$added" | grep -E '(SERVICE_ROLE_KEY|JWT_SECRET|POSTGRES_PASSWORD|GOOGLE_SECRET|ANON_KEY)=' || true)
  if [ -n "$assigns" ]; then
    # drop safe RHS: $VAR, ${VAR}, $(...), KEY:latest refs, grep patterns ('^KEY='),
    # CHANGE_ME placeholders, empty values, and lines that are clearly a flag value.
    suspicious=$(printf '%s\n' "$assigns" \
      | grep -vE "=\\\$[A-Za-z_{(]" \
      | grep -vE "=['\"]?\\\$\\(" \
      | grep -vE "[A-Z_]+=[A-Z_]+:latest" \
      | grep -vE "'\^[A-Z_]+='" \
      | grep -vE '=CHANGE_ME' \
      | grep -vE '=["'\'']?\s*$' \
      | grep -E "=['\"]?[A-Za-z0-9+/_-]{12,}" || true)
    if [ -n "$suspicious" ]; then
      echo "${RED}✗ blocked (real-looking secret assignment in staged diff).${NC}"
      blocked=1
    fi
  fi
fi

if [ "$blocked" -ne 0 ]; then
  echo
  echo "${YEL}Commit aborted by pre-commit secret guard.${NC}"
  echo "If this is a placeholder/template, rename it to *.example."
  echo "If you are certain it is safe, bypass with:  git commit --no-verify"
  exit 1
fi

exit 0
