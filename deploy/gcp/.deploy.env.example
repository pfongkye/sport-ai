# ─────────────────────────────────────────────────────────────────────────────
# Cloud Run deploy inputs for 04_deploy_app_cloudrun.sh.
#
#   cp deploy/gcp/.deploy.env.example deploy/gcp/.deploy.env
#   # fill in real values, then:
#   ./deploy/gcp/04_deploy_app_cloudrun.sh
#
# .deploy.env is GITIGNORED (contains the Strava client secret + anon key).
# Values already exported in your shell override this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────
# YOUR GCP project id — each deployer sets their OWN here (no default in the repo,
# so you can't accidentally deploy to someone else's project). e.g. my-sportai-123
GCP_PROJECT=your-gcp-project-id
# Optionally override region/zone (defaults: europe-west1 / europe-west1-b)
# GCP_REGION=europe-west1
# GCP_ZONE=europe-west1-b

# The VM's nip.io Supabase host (dashes, no scheme). Must match Caddy's cert host.
SUPABASE_DOMAIN=your-dashed-ip.nip.io
# Prod anon key — MUST match ANON_KEY in the VM docker/.env. Baked into the browser
# bundle at build time (public by design; the anon key is not a server secret).
ANON_KEY=CHANGE_ME_prod_anon_key

# ── Optional ──────────────────────────────────────────────────────────────
# App's own public URL (auth redirects + Strava redirect). If omitted, the script
# reuses the existing Cloud Run service URL automatically.
NEXT_PUBLIC_APP_URL=https://sportai-app-418551665502.europe-west1.run.app

# Access allow-list (exact emails, comma-separated). Leave BLANK to disable
# (anyone with a Google login gets in). INCLUDE YOUR OWN EMAIL or you'll lock
# yourself out — the OAuth callback rejects/deletes users not on the list.
ALLOWED_EMAILS=pfongkye@gmail.com

# Strava import (optional). Set BOTH to enable; CLIENT_SECRET is stored in Secret
# Manager by the script. Create the app at https://www.strava.com/settings/api
# with Authorization Callback Domain = your Cloud Run host (no scheme/path).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
