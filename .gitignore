# ── Secrets — NEVER commit ────────────────────────────────────
# Ignore all real docker env files (.env, .env.prod, .env.staging, …)
# but keep *.example templates committable (un-ignored below).
docker/.env
docker/.env.*
app/.env.local
app/.env*.local
.env
.env.local
.env.*
# Re-allow example templates (negations after the ignores above)
!*.env.example
!**/.env.example
!**/.env.prod.example
!**/*.env.local.example
# env backups created by ngrok-sync.sh
*.env.bak
docker/.env.bak
app/.env.local.bak
# rendered ngrok config (contains authtoken)
docker/.ngrok.rendered.yml
# Kiro MCP settings can hold API tokens in their env block — never commit.
# The rest of .kiro/ (steering, specs, hooks) IS committed intentionally.
.kiro/settings/mcp.json
**/.kiro/settings/mcp.json

# ── Dependencies ──────────────────────────────────────────────
node_modules/
app/node_modules/

# ── Next.js build output ──────────────────────────────────────
app/.next/
app/out/
app/build/
app/.vercel/
app/*.tsbuildinfo
app/next-env.d.ts

# ── Docker volumes ────────────────────────────────────────────
# Exclude persisted data but keep config files
docker/volumes/db/data/
docker/volumes/storage/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ── IDE ───────────────────────────────────────────────────────
.vscode/settings.json
.vscode/*.code-snippets
.idea/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Auto-generated by create-next-app (AI assistant context files) ───────────
app/AGENTS.md
app/CLAUDE.md

# ── Misc ──────────────────────────────────────────────────────
*.pem
coverage/
secrets/
