############################################
# Supabase Docker Stack — Environment
# Copy to .env in the docker/ directory
############################################

# Postgres
POSTGRES_PASSWORD=your-super-secret-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# JWT — generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters
JWT_EXPIRY=3600

# Supabase API keys
# Generate at: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# URLs
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000
# For Ngrok: SITE_URL=https://sportai.ngrok.io

# Additional OAuth redirect URLs (comma-separated)
ADDITIONAL_REDIRECT_URLS=

# OAuth Providers — Google is the ONLY login provider for now.
# To actually enable it in GoTrue you also need GOOGLE_ENABLED=true + these
# creds consumed by the `auth` service (see docker-compose.yml, AGENTS.md #7).
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Studio
STUDIO_PORT=8080
STUDIO_DEFAULT_ORGANIZATION=SportAI
STUDIO_DEFAULT_PROJECT=sportai

# Logging
LOGFLARE_API_KEY=your-super-secret-and-long-logflare-key

# Kong ports
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Secret key for realtime
SECRET_KEY_BASE=secret-key-for-realtime

# Email (uses inbucket for local dev — no real SMTP needed)
SMTP_ADMIN_EMAIL=admin@sportai.local
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=fake@example.com
SMTP_PASS=fake-password
SMTP_SENDER_NAME=SportAI
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# ── Ngrok (mobile testing) ────────────────────────────────
# Used by docker/ngrok-start.sh to render docker/ngrok.yml
# NGROK_AUTHTOKEN: from https://dashboard.ngrok.com
# NGROK_SUPABASE_DOMAIN: your free static domain (claim at dashboard.ngrok.com/domains)
#   pinned to the Supabase tunnel so the Google callback URL never changes
NGROK_AUTHTOKEN=
NGROK_SUPABASE_DOMAIN=
