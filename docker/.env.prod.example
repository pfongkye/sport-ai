############################################
# SportAI — PRODUCTION Supabase stack env (VM)
#
# Copy to docker/.env on the VM and fill in. Generate FRESH secrets for prod —
# do NOT reuse the dev values (except app.encryption_key if you want migrated
# test data to decrypt — see DEPLOY.md "Encryption key").
#
# Bring the stack up with:
#   docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml up -d
############################################

# ── Postgres ──────────────────────────────────────────────
# Fresh, strong password. Changing this after first DB init needs a volume reset.
POSTGRES_PASSWORD=CHANGE_ME_fresh_prod_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=db

# ── JWT + API keys ────────────────────────────────────────
# Fresh JWT secret (min 32 chars). ANON_KEY / SERVICE_ROLE_KEY must be
# regenerated from THIS secret (see README "Regenerating Secrets").
JWT_SECRET=CHANGE_ME_fresh_jwt_secret_min_32_chars
JWT_EXPIRY=3600
ANON_KEY=CHANGE_ME_regenerated_anon_key
SERVICE_ROLE_KEY=CHANGE_ME_regenerated_service_role_key

# ── Public URLs (nip.io host fronted by Caddy) ────────────
# SUPABASE_DOMAIN: VM static IP with dashes, e.g. 34-120-55-10.nip.io
SUPABASE_DOMAIN=CHANGE_ME_dashed_ip.nip.io
API_EXTERNAL_URL=https://CHANGE_ME_dashed_ip.nip.io
SUPABASE_PUBLIC_URL=https://CHANGE_ME_dashed_ip.nip.io
# SITE_URL: the Cloud Run app URL (fill after the app is deployed)
SITE_URL=https://CHANGE_ME-xxxx.a.run.app
# Comma-separated allow-list — include the Cloud Run app URL (with wildcard path)
ADDITIONAL_REDIRECT_URLS=https://CHANGE_ME-xxxx.a.run.app/**

# ── Studio dashboard basic-auth (admin profile only, never public) ────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_studio_password
STUDIO_DEFAULT_ORGANIZATION=SportAI
STUDIO_DEFAULT_PROJECT=sportai

# ── Encryption / crypto keys (see DEPLOY.md) ──────────────
# SUPABASE_ENCRYPTION_KEY here is documentation only; app.encryption_key is set
# on the DATABASE via the deploy script (03_supabase_up.sh). To decrypt migrated
# test data, use the SAME value as dev; for clean prod, generate a fresh one.
SUPABASE_ENCRYPTION_KEY=CHANGE_ME_app_encryption_key
VAULT_ENC_KEY=CHANGE_ME_32_char_vault_enc_key
REALTIME_DB_ENC_KEY=CHANGE_ME_realtime_enc_key
PG_META_CRYPTO_KEY=CHANGE_ME_pg_meta_crypto_key
SECRET_KEY_BASE=CHANGE_ME_realtime_secret_key_base_64_chars

# ── Storage ───────────────────────────────────────────────
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=stub
S3_PROTOCOL_ACCESS_KEY_ID=CHANGE_ME
S3_PROTOCOL_ACCESS_KEY_SECRET=CHANGE_ME

# ── PostgREST ─────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ── Email (autoconfirm on; wire real SMTP for prod email later) ───────────
SMTP_ADMIN_EMAIL=admin@sportai.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=SportAI
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
DISABLE_SIGNUP=false
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ── Google OAuth (enable after callback whitelisted) ──────
# Redirect URI to whitelist in Google console:
#   https://<dashed-ip>.nip.io/auth/v1/callback
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ── Supavisor pooler (not required by app/OAuth; internal only) ───────────
POOLER_TENANT_ID=sportai
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_PROXY_PORT_TRANSACTION=6543

# ── YouTube: NOT needed yet (feature unimplemented) — omit. ───────────────
